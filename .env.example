# انسخ هذا الملف باسم .env واملأ القيم الحقيقية
# لا ترفع ملف .env أبداً إلى GitHub أو أي مكان عام

# من Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI....(هذا مفتاح سري، لا تشاركه)

# من https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# اسم الموديل اللي بيستخدمه السيرفر عند الطلب من OpenAI
OPENAI_MODEL=gpt-4o-mini

# البورت اللي بيشتغل عليه السيرفر
PORT=3000
